# Copy to .env.local and fill in real values (ask the lead). Never commit .env.local.
# NEXT_PUBLIC_* values are bundled into the browser; everything else stays on the server.

# Privy dashboard → App settings → App ID (25 characters)
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy dashboard → App settings → App secret (server only)
PRIVY_APP_SECRET=

# Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → API keys → anon / publishable key (read-only via RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase → API keys → service_role / secret key (server only, bypasses RLS; used by API routes)
SUPABASE_SERVICE_ROLE_KEY=

# Base Sepolia JSON-RPC endpoint (public default is rate-limited; swap for Alchemy/Infura if needed)
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# USDC on Base Sepolia (6 decimals)
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
